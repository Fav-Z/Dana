<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feliz cumpleaños, Dana</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --celeste: #8ed0e6;
    --celeste-deep: #4a9fc0;
    --lila: #cbaee6;
    --lila-deep: #9c6fc9;
    --bg: #faf7ff;
    --ink: #3a2e4d;
    --ink-soft: #6b5d84;
    --card: #ffffff;
    --pink: #f6c9dd;
    --shadow: rgba(90, 60, 120, 0.18);
  }

  *{ box-sizing: border-box; }

  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Quicksand', sans-serif;
    overflow-x: hidden;
  }

  h1, h2, .display{
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    margin: 0;
  }

  section{
    position: relative;
    padding: 5rem 1.5rem;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ---------- HERO ---------- */

  .hero{
    min-height: 100svh;
    display:flex;
    flex-direction: column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding: 2rem 1.5rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f2e9fb 0%, var(--bg) 70%);
  }

  .balloons{
    position:absolute;
    inset:0;
    pointer-events:none;
    z-index:0;
  }

  .balloon{
    position:absolute;
    bottom: -140px;
    width: 46px;
    animation: rise linear infinite;
    opacity: 0.9;
  }

  @keyframes rise{
    0%{ transform: translateY(0) translateX(0) rotate(0deg); }
    50%{ transform: translateY(-58vh) translateX(18px) rotate(4deg); }
    100%{ transform: translateY(-116vh) translateX(-10px) rotate(-3deg); }
  }

  .hero-content{ position:relative; z-index:1; }

  .eyebrow-heart{
    font-size: 1.6rem;
    display:block;
    margin-bottom: 0.6rem;
  }

  .hero h1{
    font-size: clamp(2.6rem, 9vw, 4.2rem);
    line-height: 1.05;
    background: linear-gradient(100deg, var(--celeste-deep), var(--lila-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p{
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 30ch;
    margin-left:auto; margin-right:auto;
  }

  .scroll-hint{
    margin-top: 3rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap: 0.4rem;
  }

  .scroll-hint svg{ animation: bob 1.8s ease-in-out infinite; }

  @keyframes bob{
    0%,100%{ transform: translateY(0); }
    50%{ transform: translateY(8px); }
  }

  /* ---------- CAKE SECTION ---------- */

  .cake-section{ text-align:center; }

  .cake-section h2{
    font-size: 1.8rem;
    margin-bottom: 0.4rem;
  }

  .cake-section .sub{
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  .cake-wrap{
    position:relative;
    display:inline-block;
  }

  .flame{
    cursor:pointer;
    transform-origin: bottom center;
    animation: flicker 1.4s ease-in-out infinite;
  }

  .flame.out{
    animation:none;
    opacity:0;
    pointer-events:none;
  }

  @keyframes flicker{
    0%,100%{ transform: scale(1) rotate(-2deg); }
    50%{ transform: scale(1.08) rotate(2deg); }
  }

  .puff{
    opacity:0;
  }

  .puff.show{
    animation: puff-out 0.7s ease-out forwards;
  }

  @keyframes puff-out{
    0%{ opacity:0.9; transform: translateY(0) scale(0.4); }
    100%{ opacity:0; transform: translateY(-22px) scale(1.4); }
  }

  .cake-instruction{
    margin-top: 1.6rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .wish-message{
    margin-top: 1.6rem;
    font-family:'Fredoka', sans-serif;
    font-size: 1.3rem;
    color: var(--lila-deep);
    opacity:0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .wish-message.show{ opacity:1; transform: translateY(0); }

  .confetti-piece{
    position: fixed;
    top: -10px;
    width: 8px;
    height: 14px;
    z-index: 50;
    pointer-events:none;
    animation: confetti-fall linear forwards;
  }

  @keyframes confetti-fall{
    to{ transform: translateY(105vh) rotate(540deg); opacity: 0.9; }
  }

  /* ---------- CARDS SECTION ---------- */

  .cards-section{ text-align:center; }

  .cards-section h2{ font-size: 1.8rem; margin-bottom: 0.4rem; }

  .cards-section .sub{ color: var(--ink-soft); margin-bottom: 2.2rem; }

  .card-stage{
    position:relative;
    height: 260px;
    perspective: 1200px;
  }

  .msg-card{
    position:absolute;
    inset:0;
    margin:auto;
    width: 100%;
    max-width: 420px;
    height: 100%;
    cursor:pointer;
  }

  .msg-card-inner{
    position:relative;
    width:100%;
    height:100%;
    transition: transform 0.6s cubic-bezier(.2,.8,.2,1);
    transform-style: preserve-3d;
  }

  .msg-card.flipped .msg-card-inner{ transform: rotateY(180deg); }

  .msg-face{
    position:absolute;
    inset:0;
    border-radius: 22px;
    backface-visibility: hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    padding: 2rem;
    box-shadow: 0 16px 34px var(--shadow);
  }

  .msg-front{
    background: linear-gradient(135deg, var(--celeste), var(--lila));
    color: #fff;
    font-family:'Fredoka', sans-serif;
    font-size: 1.15rem;
    flex-direction: column;
    gap: 0.6rem;
  }

  .msg-back{
    background: var(--card);
    transform: rotateY(180deg);
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .card-dots{
    display:flex;
    justify-content:center;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .dot{
    width: 9px; height:9px;
    border-radius: 50%;
    background: #e0d3f2;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .dot.active{ background: var(--lila-deep); transform: scale(1.2); }

  .card-nav{
    display:flex;
    justify-content:center;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .nav-btn{
    border:none;
    background: var(--card);
    width: 44px; height:44px;
    border-radius:50%;
    box-shadow: 0 6px 16px var(--shadow);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    color: var(--lila-deep);
  }

  .nav-btn:active{ transform: scale(0.94); }

  /* ---------- CAPIBARA SECTION ---------- */

  .capibara-section{
    text-align:center;
    padding-bottom: 6rem;
  }

  .capi-wrap{
    cursor:pointer;
    display:inline-block;
  }

  .capi-wrap svg{ transition: transform 0.25s ease; }

  .capi-wrap:active svg{ transform: scale(0.95) rotate(-2deg); }

  .capi-bubble{
    max-width: 280px;
    margin: 1.4rem auto 0;
    background: var(--card);
    border-radius: 18px;
    padding: 1rem 1.2rem;
    box-shadow: 0 10px 24px var(--shadow);
    font-size: 1rem;
    color: var(--ink);
    opacity:0;
    transform: translateY(6px) scale(0.98);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .capi-bubble.show{ opacity:1; transform: translateY(0) scale(1); }

  footer{
    text-align:center;
    padding: 2rem 1.5rem 3rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>
</head>
<body>

<section class="hero">
  <div class="balloons" id="balloons"></div>
  <div class="hero-content">
    <span class="eyebrow-heart">🩵💜</span>
    <h1>Feliz cumpleaños,<br>Dana</h1>
    <p>Hoy cumple 20 años mi persona favorita y la mujer más linda del mundo.</p>
    <div class="scroll-hint">
      <span>desliza para tu sorpresa</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="#9c6fc9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</section>

<section class="cake-section">
  <h2>Pide un deseo 🎂</h2>
  <p class="sub">Toca cada velita para apagarla</p>

  <div class="cake-wrap">
    <svg width="220" height="200" viewBox="0 0 220 200" fill="none">
      <!-- plate -->
      <ellipse cx="110" cy="182" rx="95" ry="10" fill="#e7d9f5"/>
      <!-- bottom layer -->
      <rect x="30" y="120" width="160" height="55" rx="10" fill="#cbaee6"/>
      <rect x="30" y="120" width="160" height="14" rx="7" fill="#f6c9dd"/>
      <!-- top layer -->
      <rect x="55" y="80" width="110" height="48" rx="10" fill="#8ed0e6"/>
      <rect x="55" y="80" width="110" height="14" rx="7" fill="#fdf4ff"/>
      <!-- drips -->
      <circle cx="70" cy="128" r="7" fill="#f6c9dd"/>
      <circle cx="110" cy="130" r="7" fill="#f6c9dd"/>
      <circle cx="150" cy="128" r="7" fill="#f6c9dd"/>
      <!-- candles -->
      <g id="candle1">
        <rect x="75" y="55" width="8" height="26" rx="3" fill="#fff" />
        <g class="flame" data-candle="1">
          <ellipse cx="79" cy="48" rx="6" ry="9" fill="#f7b84b"/>
          <ellipse cx="79" cy="50" rx="3" ry="5" fill="#fff1c2"/>
        </g>
        <g class="puff" data-puff="1">
          <circle cx="79" cy="44" r="7" fill="#d8cbe9"/>
        </g>
      </g>
      <g id="candle2">
        <rect x="106" y="48" width="8" height="33" rx="3" fill="#fff" />
        <g class="flame" data-candle="2">
          <ellipse cx="110" cy="41" rx="6" ry="9" fill="#f7b84b"/>
          <ellipse cx="110" cy="43" rx="3" ry="5" fill="#fff1c2"/>
        </g>
        <g class="puff" data-puff="2">
          <circle cx="110" cy="37" r="7" fill="#d8cbe9"/>
        </g>
      </g>
      <g id="candle3">
        <rect x="137" y="55" width="8" height="26" rx="3" fill="#fff" />
        <g class="flame" data-candle="3">
          <ellipse cx="141" cy="48" rx="6" ry="9" fill="#f7b84b"/>
          <ellipse cx="141" cy="50" rx="3" ry="5" fill="#fff1c2"/>
        </g>
        <g class="puff" data-puff="3">
          <circle cx="141" cy="44" r="7" fill="#d8cbe9"/>
        </g>
      </g>
    </svg>
  </div>

  <p class="cake-instruction" id="cakeInstruction">Faltan 3 velitas</p>
  <p class="wish-message" id="wishMessage">Deseo concedido: que este año te trate tan bonito como tú me tratas a mí. 🩵</p>
</section>

<section class="cards-section">
  <h2>Unas cartitas para ti</h2>
  <p class="sub">Toca la tarjeta para leerla, luego usa las flechas</p>

  <div class="card-stage">
    <div class="msg-card" id="msgCard">
      <div class="msg-card-inner" id="msgCardInner">
        <div class="msg-face msg-front" id="msgFrontLabel">
          <span style="font-size:2rem;">💌</span>
          <span>Toca para abrir</span>
        </div>
        <div class="msg-face msg-back" id="msgBackText"></div>
      </div>
    </div>
  </div>

  <div class="card-dots" id="cardDots"></div>

  <div class="card-nav">
    <button class="nav-btn" id="prevBtn" aria-label="Anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="nav-btn" id="nextBtn" aria-label="Siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>

<section class="capibara-section">
  <div class="capi-wrap" id="capiWrap">
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none">
      <ellipse cx="70" cy="70" rx="58" ry="42" fill="#c99b6a"/>
      <ellipse cx="70" cy="66" rx="46" ry="32" fill="#dbb488"/>
      <ellipse cx="40" cy="42" rx="10" ry="9" fill="#c99b6a"/>
      <ellipse cx="100" cy="42" rx="10" ry="9" fill="#c99b6a"/>
      <circle cx="52" cy="60" r="4" fill="#3a2e4d"/>
      <circle cx="88" cy="60" r="4" fill="#3a2e4d"/>
      <ellipse cx="70" cy="78" rx="14" ry="9" fill="#efd9bd"/>
      <circle cx="70" cy="72" r="3" fill="#3a2e4d"/>
    </svg>
  </div>
  <p style="font-family:'Fredoka',sans-serif; margin-top:0.8rem; color:var(--ink-soft);">tu pimpompurin favorito dice...</p>
  <div class="capi-bubble" id="capiBubble">¡Feliz cumple, mi amor! Gracias por estos 8 meses tan bonitos. Vamos por muchos más 🩵💜</div>
</section>

<footer>hecho con cariño para Dana, por Favio</footer>

<script>
  // Balloons background
  const balloonColors = ['#8ed0e6', '#cbaee6', '#f6c9dd'];
  const balloonsContainer = document.getElementById('balloons');
  for (let i = 0; i < 9; i++) {
    const b = document.createElement('div');
    b.className = 'balloon';
    const left = Math.random() * 90 + 2;
    const duration = 9 + Math.random() * 6;
    const delay = Math.random() * 8;
    const color = balloonColors[i % balloonColors.length];
    b.style.left = left + '%';
    b.style.animationDuration = duration + 's';
    b.style.animationDelay = '-' + delay + 's';
    b.innerHTML = `
      <svg viewBox="0 0 46 60" width="46">
        <ellipse cx="23" cy="24" rx="22" ry="24" fill="${color}"/>
        <path d="M23 48 L23 60" stroke="${color}" stroke-width="2"/>
        <path d="M20 48 L23 52 L26 48 Z" fill="${color}"/>
      </svg>`;
    balloonsContainer.appendChild(b);
  }

  // Cake candles
  let litCount = 3;
  const instruction = document.getElementById('cakeInstruction');
  const wishMessage = document.getElementById('wishMessage');

  function updateInstruction(){
    if (litCount === 0){
      instruction.textContent = '¡Todas apagadas!';
      wishMessage.classList.add('show');
      launchConfetti();
    } else {
      instruction.textContent = litCount === 1 ? 'Falta 1 velita' : `Faltan ${litCount} velitas`;
    }
  }

  document.querySelectorAll('.flame').forEach(flame => {
    flame.addEventListener('click', () => {
      if (flame.classList.contains('out')) return;
      const id = flame.getAttribute('data-candle');
      flame.classList.add('out');
      const puff = document.querySelector(`.puff[data-puff="${id}"]`);
      puff.classList.add('show');
      litCount--;
      updateInstruction();
    }, { once: true });
  });

  function launchConfetti(){
    const colors = ['#8ed0e6', '#cbaee6', '#f6c9dd', '#f7b84b'];
    for (let i = 0; i < 60; i++){
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.left = Math.random() * 100 + 'vw';
      piece.style.background = colors[Math.floor(Math.random() * colors.length)];
      piece.style.animationDuration = (2.2 + Math.random() * 1.6) + 's';
      piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      document.body.appendChild(piece);
      setTimeout(() => piece.remove(), 4200);
    }
  }

  // Message cards
  const messages = [
    'Hace 8 meses empezamos esto, y cada día contigo se siente tan bonito como el primero.',
    'Me encanta tu risa, tu forma de ver el mundo, y hasta cuando pareces una capibara feliz tomando sol 🐹',
    'Contigo todo se siente más fácil. Gracias por ser mi compañera de vida, mi risa diaria y mi paz.',
    'Espero seguir sumando meses, años y compartir muchos momentos más contigo.',
    'Feliz cumpleaños, mi amor. Que este año te traiga tantas cosas lindas como las que tú me traes a mí, hoy es tu día, asi que te toca disfrutar como una reina, sabes que te amo mucho y siempre voy a desearte lo mejor.'
  ];

  let currentIndex = 0;
  const card = document.getElementById('msgCard');
  const backText = document.getElementById('msgBackText');
  const dotsContainer = document.getElementById('cardDots');

  messages.forEach((_, i) => {
    const dot = document.createElement('div');
    dot.className = 'dot' + (i === 0 ? ' active' : '');
    dotsContainer.appendChild(dot);
  });

  function renderCard(){
    backText.textContent = messages[currentIndex];
    card.classList.remove('flipped');
    [...dotsContainer.children].forEach((d, i) => d.classList.toggle('active', i === currentIndex));
  }
  renderCard();

  card.addEventListener('click', () => card.classList.toggle('flipped'));

  document.getElementById('nextBtn').addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % messages.length;
    renderCard();
  });
  document.getElementById('prevBtn').addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + messages.length) % messages.length;
    renderCard();
  });

  // Capibara easter egg
  const capiWrap = document.getElementById('capiWrap');
  const capiBubble = document.getElementById('capiBubble');
  capiWrap.addEventListener('click', () => {
    capiBubble.classList.toggle('show');
  });
</script>

</body>
</html>
